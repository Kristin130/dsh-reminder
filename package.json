{
  "name": "dsh-reminder",
  "version": "0.1.1",
  "description": "peon-ping sound notifications for DeepSeek Harness — a faithful port of the pi plugin pi-peon-ping-win (native Windows audio fallback, WinForms popup, OpenPeon sound packs). Beeps only when a task completes or terminates unexpectedly, by default.",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "peon-ping",
    "sound",
    "notification",
    "windows",
    "dsh-plugin",
    "deepseek-harness-plugin",
    "port"
  ],
  "license": "MIT",
  "author": "Kristin130",
  "contributors": [
    "cppgohan (pi-peon-ping-win)",
    "Josh Thomas <josh@joshuadavidthomas.com> (original pi-peon-ping)",
    "PeonPing (peon-ping)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kristin130/dsh-reminder.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "publish:public": "npm publish --registry https://registry.npmjs.org",
    "publish:dry-run": "npm publish --dry-run --registry https://registry.npmjs.org",
    "publish:otp": "npm publish --registry https://registry.npmjs.org --otp"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-title": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-title": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-commands": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-session-title": "^0.0.1-rc.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
